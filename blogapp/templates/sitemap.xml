{{define "sitemap.xml"}}<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{abs "/devlog"}}</loc><changefreq>daily</changefreq><priority>0.9</priority></url>
  <url><loc>{{abs "/journal"}}</loc><changefreq>daily</changefreq><priority>0.9</priority></url>
  <url><loc>{{abs "/search"}}</loc><changefreq>weekly</changefreq><priority>0.4</priority></url>
  {{range .Posts}}
  <url><loc>{{abs .URL}}</loc><lastmod>{{dateISO .PublishedAt}}</lastmod><changefreq>monthly</changefreq><priority>0.8</priority></url>
  {{end}}
</urlset>{{end}}
